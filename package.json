{
	"name": "prisma-web",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"public": "vite --mode public",
		"research": "vite --mode research",
		"build": "tsc && vite build",
		"build:dev": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode development",
		"build:prod": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode production",
		"build:test": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode test",
		"build:public": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode public",
		"build:research": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode research",
		"release:public": "npm run fetch-tags && git tag -f PUBLIC && npm run push-tags",
		"release:prod": "npm run fetch-tags && git tag -f PROD && npm run push-tags",
		"release:test": "npm run fetch-tags && git tag -f TEST && npm run push-tags",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"tsc": "tsc --build --noEmit",
		"prettier": "prettier --check ./src",
		"preview": "vite preview",
		"fetch-tags": "git fetch origin --tags --force",
		"push-tags": "git push origin --tags -f"
	},
	"dependencies": {
		"@azure/msal-browser": "^5.20.0",
		"@azure/msal-react": "^5.7.0",
		"@dagrejs/dagre": "^3.1.1",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/collision": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@equinor/eds-core-react": "^2.6.2",
		"@equinor/eds-icons": "^1.5.1",
		"@hookform/error-message": "^2.0.1",
		"@hookform/resolvers": "^5.9.1",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@tanstack/react-hotkeys": "^0.10.0",
		"@tanstack/react-query": "^5.102.8",
		"@uidotdev/usehooks": "^2.4.1",
		"@xyflow/react": "^12.11.6",
		"axios": "^1.20.0",
		"date-fns": "^4.4.0",
		"elkjs": "^0.12.0",
		"jotai": "^2.20.3",
		"jotai-family": "^1.1.0",
		"perfect-freehand": "^1.2.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"react-router": "^8.3.1",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@hookform/devtools": "^4.4.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.5.3",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vite-plugin-checker": "^0.14.5"
	}
}
