{
	"name": "dot-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:dev": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode development",
		"build:prod": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode production",
		"build:test": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode test",
		"release:prod": "npm run fetch-tags && git tag -f PROD && npm run push-tags",
		"release:test": "npm run fetch-tags && git tag -f TEST && npm run push-tags",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"tsc": "tsc --build --noEmit",
		"prettier": "prettier --check ./src",
		"preview": "vite preview",
		"fetch-tags": "git fetch origin --tags --force",
		"push-tags": "git push origin --tags -f"
	},
	"dependencies": {
		"@azure/msal-browser": "^4.27.0",
		"@azure/msal-react": "^3.0.23",
		"@dagrejs/dagre": "^1.1.8",
		"@dnd-kit/abstract": "^0.2.1",
		"@dnd-kit/collision": "^0.2.1",
		"@dnd-kit/helpers": "^0.2.1",
		"@dnd-kit/react": "^0.2.1",
		"@equinor/eds-core-react": "^2.2.0",
		"@equinor/eds-icons": "^1.1.0",
		"@hookform/error-message": "^2.0.1",
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@tanstack/react-query": "^5.90.16",
		"@uidotdev/usehooks": "^2.4.1",
		"@xyflow/react": "^12.10.0",
		"axios": "^1.13.2",
		"date-fns": "^4.1.0",
		"jotai": "^2.16.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-hook-form": "^7.70.0",
		"react-router": "^7.11.0",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@hookform/devtools": "^4.4.0",
		"@tailwindcss/vite": "^4.1.18",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9.39.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vite": "^7.3.0",
		"vite-plugin-checker": "^0.12.0"
	}
}
