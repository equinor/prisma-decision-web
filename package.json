{
	"name": "dot-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:dev": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode development",
		"build:prod": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode production",
		"build:test": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode test",
		"release:prod": "npm run fetch-tags && git tag -f PROD && npm run push-tags",
		"release:test": "npm run fetch-tags && git tag -f TEST && npm run push-tags",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"tsc": "tsc",
		"prettier": "prettier --check ./src",
		"preview": "vite preview",
		"fetch-tags": "git fetch origin --tags --force",
		"push-tags": "git push origin --tags -f"
	},
	"dependencies": {
		"@azure/msal-browser": "^4.22.1",
		"@azure/msal-react": "^3.0.19",
		"@dnd-kit/abstract": "^0.1.21",
		"@dnd-kit/collision": "^0.1.21",
		"@dnd-kit/helpers": "^0.1.21",
		"@dnd-kit/react": "^0.1.21",
		"@equinor/eds-icons": "^0.22.0",
		"@hookform/error-message": "^2.0.1",
		"@hookform/resolvers": "^5.2.1",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@tanstack/react-query": "^5.87.4",
		"@uidotdev/usehooks": "^2.4.1",
		"@xyflow/react": "^12.8.4",
		"axios": "^1.12.2",
		"jotai": "^2.14.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-hook-form": "^7.62.0",
		"react-router": "^7.8.2",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@equinor/eds-core-react": "^0.49.0",
		"@hookform/devtools": "^4.4.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/react": "^19.1.12",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.2",
		"eslint": "^9.35.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.1.13",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.43.0",
		"vite": "^7.1.5",
		"vite-plugin-checker": "^0.10.3"
	}
}
