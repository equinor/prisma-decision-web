{
	"name": "dot-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:dev": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode development",
		"build:prod": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode production",
		"build:test": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode test",
		"release:prod": "npm run fetch-tags && git tag -f PROD && npm run push-tags",
		"release:test": "npm run fetch-tags && git tag -f TEST && npm run push-tags",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"tsc": "tsc",
		"prettier": "prettier --check ./src",
		"preview": "vite preview",
		"fetch-tags": "git fetch origin --tags --force",
		"push-tags": "git push origin --tags -f"
	},
	"dependencies": {
		"@azure/msal-browser": "^4.25.0",
		"@azure/msal-react": "^3.0.20",
		"@dnd-kit/abstract": "^0.1.21",
		"@dnd-kit/collision": "^0.1.21",
		"@dnd-kit/helpers": "^0.1.21",
		"@dnd-kit/react": "^0.1.21",
		"@equinor/eds-core-react": "^1.0.0",
		"@equinor/eds-icons": "^1.0.0",
		"@hookform/error-message": "^2.0.1",
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@tanstack/react-query": "^5.90.3",
		"@uidotdev/usehooks": "^2.4.1",
		"@xyflow/react": "^12.8.6",
		"axios": "^1.12.2",
		"date-fns": "^4.1.0",
		"jotai": "^2.15.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.65.0",
		"react-router": "^7.9.4",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@hookform/devtools": "^4.4.0",
		"@tailwindcss/vite": "^4.1.14",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.0.4",
		"eslint": "^9.37.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.23",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.1.14",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.11",
		"vite-plugin-checker": "^0.11.0"
	}
}
