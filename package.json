{
	"name": "dot-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:dev": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode development",
		"build:prod": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode production",
		"release:prod": "npm run fetch-tags && git tag -f PROD && npm run push-tags",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"tsc": "tsc",
		"prettier": "prettier --check ./src",
		"preview": "vite preview",
		"fetch-tags": "git fetch origin --tags --force",
		"push-tags": "git push origin --tags -f"
	},
	"dependencies": {
		"@equinor/eds-core-react": "^0.45.1",
		"@equinor/eds-icons": "^0.22.0",
		"@uidotdev/usehooks": "^2.4.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.5.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.4",
		"@types/react": "^19.0.10",
		"@types/react-dom": "^19.1.2",
		"@typescript-eslint/eslint-plugin": "^8.29.0",
		"@typescript-eslint/parser": "^8.31.0",
		"@vitejs/plugin-react": "^4.4.1",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-no-inline-styles": "^1.0.5",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tailwindcss": "^4.1.4",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.31.0",
		"vite": "^6.3.3",
		"vite-plugin-checker": "^0.9.3"
	}
}
