{
	"name": "prisma-web",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"public": "vite --mode public",
		"research": "vite --mode research",
		"build": "tsc && vite build",
		"build:dev": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode development",
		"build:prod": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode production",
		"build:test": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode test",
		"build:public": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode public",
		"build:research": "DISABLE_ESLINT_PLUGIN=true tsc && vite build --mode research",
		"release:public": "npm run fetch-tags && git tag -f PUBLIC && npm run push-tags",
		"release:prod": "npm run fetch-tags && git tag -f PROD && npm run push-tags",
		"release:test": "npm run fetch-tags && git tag -f TEST && npm run push-tags",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"tsc": "tsc --build --noEmit",
		"prettier": "prettier --check ./src",
		"preview": "vite preview",
		"fetch-tags": "git fetch origin --tags --force",
		"push-tags": "git push origin --tags -f"
	},
	"dependencies": {
		"@azure/msal-browser": "^5.15.0",
		"@azure/msal-react": "^5.5.0",
		"@dagrejs/dagre": "^3.0.0",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/collision": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@equinor/eds-core-react": "^2.6.1",
		"@equinor/eds-icons": "^1.5.0",
		"@hookform/error-message": "^2.0.1",
		"@hookform/resolvers": "^5.4.0",
		"@radix-ui/react-collapsible": "^1.1.14",
		"@tanstack/react-query": "^5.101.1",
		"@uidotdev/usehooks": "^2.4.1",
		"@xyflow/react": "^12.11.1",
		"axios": "^1.18.1",
		"date-fns": "^4.4.0",
		"elkjs": "^0.11.1",
		"jotai": "^2.20.1",
		"jotai-family": "^1.0.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.80.0",
		"react-router": "^8.0.1",
		"recharts": "^3.9.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@hookform/devtools": "^4.4.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.5.3",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.1",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "8.0.16",
		"vite-plugin-checker": "0.14.1"
	}
}